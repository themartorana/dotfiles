# Single source of PATH (and other environment) for every shell.
# Sourced by every zsh (.zshenv, plus .zprofile to undo macOS path_helper
# reordering) and by bash (.bash_profile, .bashrc). Sourced repeatedly, so
# keep it POSIX, silent and idempotent.

# Move $1 to the front (path_prepend) or back (path_append) of PATH,
# removing any existing occurrence so repeated sourcing never duplicates.
_path_without() {
    _p=":$PATH:"
    while :; do
        case "$_p" in
            *":$1:"*) _p="${_p%%":$1:"*}:${_p#*":$1:"}" ;;
            *) break ;;
        esac
    done
    _p="${_p#:}"
    _p="${_p%:}"
}
path_prepend() { _path_without "$1"; PATH="$1${_p:+:$_p}"; unset _p; }
path_append() { _path_without "$1"; PATH="${_p:+$_p:}$1"; unset _p; }

# Look locally first. Prepends run bottom-up: the last line ends up first.
path_prepend /opt/homebrew/sbin
path_prepend /opt/homebrew/bin
path_prepend "${HOME}/.cargo/bin"
path_prepend "${HOME}/.local/bin"
path_prepend "${HOME}/bin"

# Setup Amazon EC2 Command-Line Tools
export EC2_HOME="${HOME}/.ec2"
path_append "${EC2_HOME}/bin"

export PATH

# Default editor: first of nvim, vim, vi on PATH; override in .profile.local.
for _e in nvim vim vi; do
    if command -v "$_e" >/dev/null 2>&1; then
        export EDITOR="$_e"
        break
    fi
done
unset _e

# shellcheck disable=SC1091
[ -f "${HOME}/.profile.local" ] && . "${HOME}/.profile.local"

# Go binaries (go install), appended to the end of PATH. Resolved after
# .profile.local so its GOPATH, GOBIN or go install location count. An
# exported GOBIN is used as is. Otherwise go env (~30ms) is asked once and the
# answer cached in DOTFILES_GOBIN for child shells. Never export GOBIN
# ourselves: Go refuses cross-compiled installs when GOBIN is set.
if [ -n "${GOBIN:-}" ]; then
    _gobin="$GOBIN"
elif [ -n "${DOTFILES_GOBIN:-}" ]; then
    _gobin="$DOTFILES_GOBIN"
elif command -v go >/dev/null 2>&1; then
    # One call, two lines: GOBIN (from go env -w, may be empty), then GOPATH.
    # A failing go (e.g. a version-manager shim with no version) means no dir,
    # not an aborted profile under set -e.
    _goenv="$(go env GOBIN GOPATH 2>/dev/null)" || _goenv=
    _gobin="${_goenv%%
*}"
    if [ -z "$_gobin" ]; then
        _gobin="${_goenv#*
}"
        # GOPATH may be a list; its first entry holds the binaries.
        _gobin="${_gobin%%:*}"
        [ -n "$_gobin" ] && _gobin="${_gobin}/bin"
    fi
    [ -n "$_gobin" ] && export DOTFILES_GOBIN="$_gobin"
    unset _goenv
fi
# Append only if missing: path_append would move an entry that's already in
# PATH (e.g. GOBIN=~/.local/bin) to the end.
case ":$PATH:" in
    *":${_gobin:-}:"*) ;;
    *) [ -n "${_gobin:-}" ] && path_append "$_gobin" ;;
esac
unset _gobin
export PATH

unset -f _path_without path_prepend path_append

# XDG Base Directory Specification
# Will not override specifications in .profile.local
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}"
