# History
export HISTFILE=~/.bash_history
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
export PROMPT_COMMAND='history -a'

# PATH and environment (idempotent; also loaded by .bash_profile)
[ -f "$HOME/.profile" ] && source "$HOME/.profile"

# Starship
eval "$(starship init bash)"

# FZF
export FZF_DEFAULT_COMMAND='ag --nocolor -g ""'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='
  --height=10%
  --inline-info
  --header=Find:
  --color fg:242,bg:236,hl:65,fg+:15,bg+:239,hl+:108
  --color info:108,prompt:109,spinner:108,pointer:168,marker:168
'
command -v fzf >/dev/null && eval "$(fzf --bash 2>/dev/null)"

# Source aliases if the file exists
[ -f $HOME/.aliases ] && source $HOME/.aliases

# Local
[[ -f "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"

# VSCode Extensions installer
[ -f ~/.vscode-extensions-installer ] && source ~/.vscode-extensions-installer && install_extensions
