# History
SAVEHIST=10000
HISTSIZE=10000
HISTFILE=$HOME/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY

# fpath for local completions and Homebrew
fpath=($fpath $HOME/.zsh/completions)
fpath=($fpath /opt/homebrew/share/zsh/site-functions)

# compinit
autoload -U compinit
setopt EXTENDEDGLOB
for dump in $HOME/.zcompdump(#qN.m1); do
  compinit
  if [[ -s "$dump" && (! -s "$dump.zwc" || "$dump" -nt "$dump.zwc") ]]; then
    zcompile "$dump"
  fi
done
unsetopt EXTENDEDGLOB
compinit -C

# Antidote
source $HOME/.antidote/antidote.zsh
antidote load ~/.zsh_plugins.txt

# Tailnet machine name for the prompt (see starship.toml). Looked up once per
# shell and inherited by child shells; cleared when MACHINE_NAME overrides it.
if [ -n "${MACHINE_NAME:-}" ]; then
    unset TAILNET_HOSTNAME
elif [ -z "${TAILNET_HOSTNAME:-}" ] \
    && command -v tailscale >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    TAILNET_HOSTNAME="$(tailscale status --self --peers=false --json 2>/dev/null \
        | jq -r '.Self.DNSName // empty' 2>/dev/null)"
    TAILNET_HOSTNAME="${TAILNET_HOSTNAME%%.*}"
    if [ -n "$TAILNET_HOSTNAME" ]; then export TAILNET_HOSTNAME; else unset TAILNET_HOSTNAME; fi
fi

# Starship
eval "$(starship init zsh)"

# Completion - tab menu, coloring, fuzzy matching
zstyle ':completion:*' menu select=2
zstyle ':completion:*' list-colors 'exfxcxdxbxegedabagacad'
zstyle ':completion:*' matcher-list '' \
  'm:{a-z\-}={A-Z\_}' \
  'r:[^[:alpha:]]||[[:alpha:]]=** r:|=* m:{a-z\-}={A-Z\_}' \
  'r:|?=** m:{a-z\-}={A-Z\_}'

# FZF
export FZF_DEFAULT_COMMAND='ag --nocolor -g ""'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='
  --height=10%
  --inline-info
  --header=Find:
  --color fg:242,bg:236,hl:65,fg+:15,bg+:239,hl+:108
  --color info:108,prompt:109,spinner:108,pointer:168,marker:168
'
# fzf >= 0.48 provides its own integration; older installs use the legacy file
if _fzf_init="$(fzf --zsh 2>/dev/null)"; then
    eval "$_fzf_init"
elif [[ -f ~/.fzf.zsh ]]; then
    source ~/.fzf.zsh
fi
unset _fzf_init

# Source aliases if the file exists
[[ -f $HOME/.aliases ]] && source $HOME/.aliases

# Load local .zshrc.local if it exists
[[ -s "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# VSCode Extensions installer
[[ -f ~/.vscode-extensions-installer ]] && source ~/.vscode-extensions-installer && install_extensions
