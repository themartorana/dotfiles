# Load .profile: PATH and environment for every zsh, including scripts
[[ -s "${HOME}/.profile" ]] && source "${HOME}/.profile"

# Load .zshenv.local if it exists
[[ -s "${HOME}/.zshenv.local" ]] && source "${HOME}/.zshenv.local"

# antidote plugin clones: XDG cache on every OS (antidote's own macOS default
# is ~/Library/Caches). Override in .zshenv.local.
export ANTIDOTE_HOME="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/antidote}"
